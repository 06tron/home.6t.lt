{
	"name": "home",
	"compatibility_date": "2026-11-17", // occasionally reset to current day
	// "main": "src/index.ts",
	"assets": {
		"directory": "homepage", // renamed from static-assets
		"html_handling": "none",
		"not_found_handling": "404-page"
	},
	"routes": [
		{
			"custom_domain": true,
			"pattern": "home.6t.lt"
		}
	],
	"env": {
		"beta": { // renamed from staging
			"routes": [
				{
					"custom_domain": true,
					"pattern": "xn--zca.6t.lt"
				}
			]
		}
	},
	"$schema": "/usr/local/lib/node_modules/wrangler/config-schema.json"
}
